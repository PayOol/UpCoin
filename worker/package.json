{
  "name": "upcoin-sebpay-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply upcoin-sebpay --local",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  }
}
